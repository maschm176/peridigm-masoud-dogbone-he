environment
  tabular_data
    tabular_data_file = 'dakota_tabular_HE0_sfc3_d2_sweep3.dat'

method
  list_parameter_study
    # Tight check around D2=1.0 (D1=0.02, D3=3.0 fixed, ThresholdDamage=
    # 0.97). D2=1.0 gave fracture 15.60% (obj=0.0512), an outlier vs its
    # wider-spaced neighbors 0.75/0.9/1.1/1.25 (all 16.3-17.6%). Checking
    # for a real narrow basin vs. an isolated fluke.
    list_of_points = 0.95  1.05

variables
  continuous_design = 1
    descriptors 'DamageParameter2'
  continuous_state = 7
    descriptors      'DamageParameter1'  'DamageParameter3'  'ThresholdDamage'  'InitialYieldStress'  'SaturatedYieldStress'  'ExponentialConstant'  'LinearConstant'
    initial_state     0.02                3.0                 0.97               9.77e9                 1.35e10                 22.0                   2.0e8

interface
  analysis_drivers = 'driver_HE0_voce_hypoelastic_d2_sweep3.sh'
  fork
    parameters_file = 'params.in'
    results_file    = 'results.out'
    file_tag
  asynchronous evaluation_concurrency = 2

responses
  objective_functions = 1
  no_gradients
  no_hessians
