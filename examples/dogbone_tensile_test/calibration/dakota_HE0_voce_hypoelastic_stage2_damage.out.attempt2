environment
  tabular_data
    tabular_data_file = 'dakota_tabular_HE0_voce_hypoelastic_stage2.dat'

method
  coliny_pattern_search
    max_function_evaluations = 30

variables
  # Hardening params below are Stage 1's actual result: best of 10
  # evaluations (obj=0.0360), Dakota's search was manually halted there
  # since gains had clearly plateaued (eval 9 of the planned 25 -- see
  # CLAUDE.md). Only InitialYieldStress moved meaningfully from the old
  # Bond-Associated-tuned warm start (9.27e9 -> 9.77e9, +5.4%).
  #
  # DamageParameter1/2/3 bounds/warm-start are informed by Behzadinasab &
  # Foster's SFC3 paper (same Peridigm/Dakota workflow, same power-law
  # hardening formula, same Johnson Cook damage formula) -- their calibrated
  # d1=0.04, d2=2.5, d3=3 and search bounds d1[0.01,0.6] d2[0.1,4] d3[0.1,5]
  # showed our own D2 upper bound (0.5) had been far too tight, and that D3
  # should stay non-negative (our own negative-D3 excursions under
  # power-law were non-physical and caused the Stage 2/3 NaN crashes -- see
  # CLAUDE.md). Warm-started from the original informed guess
  # (D1=0.30, D2=0.04, D3=0.3), not the negative values found under
  # power-law, which are a numerically fragile dead end specific to that
  # hardening law's shape deficiency.
  #
  # ThresholdDamage is fixed (continuous_state, not searched) near 1.0 to
  # approximate a hard bond-cutoff damage function (see
  # driver_HE0_voce_hypoelastic_stage2_damage.sh for the rationale) --
  # Voce's own necking already supplies gradual pre-fracture softening, so
  # Johnson Cook doesn't need a wide ramp to do that job too. First attempt
  # used 0.97 (a near-instant cutoff) and crashed at eval 4/5 with
  # "isotropic_hardening_correspondence.cxx::radialReturnSaturationExponential:
  # Too many iterations in the plastic radial return" -- the near-simultaneous
  # loss of strength across many bonds at once was abrupt enough to push the
  # Voce plasticity model's local return-mapping iteration outside its
  # convergence region. 0.85 still gives a much narrower ramp than the
  # original wide-ramp default (0.5) while leaving the solver enough room to
  # converge normally (comfortably below the template's fixed Critical
  # Damage = 0.999).
  #
  # DamageParameter2's lower_bounds was also fixed here: it was previously
  # 0.05, above the intended 0.04 initial_point, so Dakota silently clamped
  # the warm start up to 0.05 on the first attempt. Now 0.02, matching
  # DamageParameter1's lower bound, so the true warm start is honored.
  continuous_design = 3
    descriptors                    'DamageParameter1'  'DamageParameter2'  'DamageParameter3'
    initial_point                   0.30                0.04                0.3
    lower_bounds                    0.02                0.02                0.0
    upper_bounds                    0.60                4.00                5.0
  continuous_state = 5
    descriptors                    'InitialYieldStress'  'SaturatedYieldStress'  'ExponentialConstant'  'LinearConstant'  'ThresholdDamage'
    initial_state                   9.77e9                 1.35e10                 22.0                   2.0e8             0.85

interface
  analysis_drivers = 'driver_HE0_voce_hypoelastic_stage2_damage.sh'
  fork
    parameters_file = 'params.in'
    results_file    = 'results.out'
    file_tag
  asynchronous evaluation_concurrency = 2

responses
  objective_functions = 1
  no_gradients
  no_hessians

