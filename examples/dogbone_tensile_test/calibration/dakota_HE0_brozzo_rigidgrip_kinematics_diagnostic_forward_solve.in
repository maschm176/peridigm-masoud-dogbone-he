environment

method
  list_parameter_study
    # Single evaluation: HE_0's locked-in Brozzo parameters, rigid-grip BC,
    # ramp mode. Not an optimization -- a one-off diagnostic run adding
    # Jacobian_Determinant and Cauchy_Stress to the output, to test the
    # compression-instability hypothesis from Behzadinasab & Foster 2019.
    list_of_points =  9.77e9  1.35e10  22.0  2.0e8  3.5  0.99  0.85

variables
  continuous_design = 7
    descriptors  'InitialYieldStress'  'SaturatedYieldStress'  'ExponentialConstant'  'LinearConstant'  'DamageParameter1'  'DamageParameter2'  'ThresholdDamage'

interface
  analysis_drivers = 'driver_HE0_brozzo_rigidgrip_kinematics_diagnostic_forward_solve.sh'
  fork
    parameters_file = 'params.in'
    results_file    = 'results.out'

responses
  objective_functions = 1
  no_gradients
  no_hessians
