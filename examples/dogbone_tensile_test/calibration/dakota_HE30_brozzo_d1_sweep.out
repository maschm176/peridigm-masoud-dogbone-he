environment
  tabular_data
    tabular_data_file = 'dakota_tabular_HE30_brozzo_d1_sweep.dat'

method
  list_parameter_study
    # Coarse d1 sweep for HE_30, d2=0.99 (HE_0's converged value) and
    # ThresholdDamage=0.85 fixed. Bracketing around HE_0's own converged
    # d1=3.5, extending higher since HE_30 is more embrittled (real fracture
    # at 13.27% vs HE_0's 15.37%) and faster damage accumulation (higher d1)
    # is the expected direction for a more easily-fractured material. 6.0
    # caused a NaN crash in HE_0's original sweep (under d2=0.95) -- staying
    # below that as a starting precaution, though the crash boundary may
    # differ now that d2=0.99 is fixed instead.
    list_of_points = 2.0  3.5  5.0  7.0

variables
  continuous_design = 1
    descriptors 'DamageParameter1'
  continuous_state = 6
    descriptors      'DamageParameter2'  'ThresholdDamage'  'InitialYieldStress'  'SaturatedYieldStress'  'ExponentialConstant'  'LinearConstant'
    initial_state     0.99                0.85               1.027e10              1.35e10                 22.0                   2.0e8

interface
  analysis_drivers = 'driver_HE30_brozzo_d1_sweep.sh'
  fork
    parameters_file = 'params.in'
    results_file    = 'results.out'
    file_tag
    asynchronous evaluation_concurrency = 2

responses
  objective_functions = 1
  no_gradients
  no_hessians

----------------
End Dakota input
