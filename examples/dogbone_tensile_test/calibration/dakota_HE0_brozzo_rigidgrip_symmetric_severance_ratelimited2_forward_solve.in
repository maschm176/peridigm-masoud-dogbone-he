environment

method
  list_parameter_study
    # Single evaluation: same point as the first rate-limited test
    # (propagation rate 0.02/step), now ALSO throttling Bond Cleanup at
    # the same 0.02/step rate, to test whether Bond Cleanup's own instant
    # all-remaining-bonds action (not the per-bond mirror-kill) is the
    # real driver of the avalanche's width.
    list_of_points =  9.77e9  1.35e10  22.0  2.0e8  3.5  0.99  0.85  0.20  0.02  0.02

variables
  continuous_design = 10
    descriptors  'InitialYieldStress'  'SaturatedYieldStress'  'ExponentialConstant'  'LinearConstant'  'DamageParameter1'  'DamageParameter2'  'ThresholdDamage'  'ConnectivityAsymmetryThreshold'  'SymmetricPropagationRate'  'BondCleanupRate'

interface
  analysis_drivers = 'driver_HE0_brozzo_rigidgrip_symmetric_severance_ratelimited2_forward_solve.sh'
  fork
    parameters_file = 'params.in'
    results_file    = 'results.out'

responses
  objective_functions = 1
  no_gradients
  no_hessians
