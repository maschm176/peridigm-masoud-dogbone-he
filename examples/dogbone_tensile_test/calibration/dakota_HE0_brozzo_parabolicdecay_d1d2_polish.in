environment
  tabular_data
    tabular_data_file = 'dakota_tabular_HE0_brozzo_parabolicdecay_d1d2_polish.dat'

method
  coliny_pattern_search
    max_function_evaluations = 6

variables
  # Joint d1/d2 polish under Influence Function: Parabolic Decay,
  # warm-started at the already-evaluated point (d1=3.5, d2=0.95,
  # obj=0.120). Same bounds as the constant-influence-function polish
  # search (paused before completion) -- bracketing the two best d1 sweep
  # points with a little headroom, and a modest window around d2's
  # original value. ThresholdDamage=0.85 and hardening fixed.
  continuous_design = 2
    descriptors                    'DamageParameter1'  'DamageParameter2'
    initial_point                   3.5                 0.95
    lower_bounds                    3.0                 0.75
    upper_bounds                    4.5                 1.15
  continuous_state = 5
    descriptors                    'ThresholdDamage'  'InitialYieldStress'  'SaturatedYieldStress'  'ExponentialConstant'  'LinearConstant'
    initial_state                   0.85               9.77e9                1.35e10                 22.0                   2.0e8

interface
  analysis_drivers = 'driver_HE0_brozzo_parabolicdecay_d1d2_polish.sh'
  fork
    parameters_file = 'params.in'
    results_file    = 'results.out'
    file_tag
  asynchronous evaluation_concurrency = 2

responses
  objective_functions = 1
  no_gradients
  no_hessians
