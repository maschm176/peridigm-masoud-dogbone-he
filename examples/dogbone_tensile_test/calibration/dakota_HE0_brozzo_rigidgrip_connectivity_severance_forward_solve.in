environment

method
  list_parameter_study
    # Single evaluation: HE_0's locked-in Brozzo parameters, rigid-grip BC,
    # plus the new Connectivity Severance mechanism at threshold 0.35 (a
    # first real test value -- measured real asymmetry plateaus around
    # 0.49, close to the 0.5 theoretical ceiling for losing one whole
    # hemisphere of bonds; 0.35 is meaningfully below that, selective to
    # ~52 of 12025 points at the observed distribution).
    list_of_points =  9.77e9  1.35e10  22.0  2.0e8  3.5  0.99  0.85  0.20

variables
  continuous_design = 8
    descriptors  'InitialYieldStress'  'SaturatedYieldStress'  'ExponentialConstant'  'LinearConstant'  'DamageParameter1'  'DamageParameter2'  'ThresholdDamage'  'ConnectivityAsymmetryThreshold'

interface
  analysis_drivers = 'driver_HE0_brozzo_rigidgrip_connectivity_severance_forward_solve.sh'
  fork
    parameters_file = 'params.in'
    results_file    = 'results.out'

responses
  objective_functions = 1
  no_gradients
  no_hessians
