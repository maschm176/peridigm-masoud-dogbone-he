environment

method
  list_parameter_study
    # Single evaluation, re-running our locked-in best Brozzo result
    # (d1=3.5, d2=0.99, ThresholdDamage=0.85) with a native Peridigm Contact
    # model (Short Range Force, General + Self Contact) added, to see whether
    # it removes the known post-fracture oscillation. Not an optimization --
    # a one-off diagnostic forward solve.
    list_of_points =  9.77e9  1.35e10  22.0  2.0e8  3.5  0.99  0.85

variables
  continuous_design = 7
    descriptors  'InitialYieldStress'  'SaturatedYieldStress'  'ExponentialConstant'  'LinearConstant'  'DamageParameter1'  'DamageParameter2'  'ThresholdDamage'

interface
  analysis_drivers = 'driver_HE0_brozzo_contact_forward_solve.sh'
  fork
    parameters_file = 'params.in'
    results_file    = 'results.out'

responses
  objective_functions = 1
  no_gradients
  no_hessians
