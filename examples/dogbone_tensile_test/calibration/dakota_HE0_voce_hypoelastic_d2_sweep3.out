environment
  tabular_data
    tabular_data_file = 'dakota_tabular_HE0_sfc3_d2_sweep3.dat'

method
  list_parameter_study
    # Tight check around D2=1.0 (D1=0.02, D3=3.0 fixed, ThresholdDamage=
    # 0.97). D2=1.0 gave fracture 15.60% (obj=0.0512), an outlier vs its
