environment

method
  list_parameter_study
    # Single evaluation: HE_0's locked-in optimized Voce hardening
    # parameters, with NO damage model attached at all (see
    # voce_hypoelastic_nodamage_input_template.yaml) -- the cleanest
    # possible "damage disabled" reference run, zero risk of any bond ever
    # losing strength regardless of how extreme the necking strain gets.
    # Not an optimization -- a one-off reference run for the post-fracture
    # ringing investigation.
    list_of_points =  9.77e9  1.35e10  22.0  2.0e8

variables
  continuous_design = 4
    descriptors  'InitialYieldStress'  'SaturatedYieldStress'  'ExponentialConstant'  'LinearConstant'

interface
  analysis_drivers = 'driver_HE0_voce_nodamage_forward_solve.sh'
  fork
    parameters_file = 'params.in'
    results_file    = 'results.out'

responses
  objective_functions = 1
  no_gradients
  no_hessians
