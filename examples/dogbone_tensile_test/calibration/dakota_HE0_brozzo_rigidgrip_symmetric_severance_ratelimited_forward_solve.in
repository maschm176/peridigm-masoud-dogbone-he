environment

method
  list_parameter_study
    # Single evaluation: HE_0's locked-in Brozzo parameters, rigid-grip BC,
    # Connectivity Severance threshold 0.20 (same as every prior test in
    # this sub-investigation), Symmetric Severance Propagation enabled,
    # with the per-bond mirroring kill rate throttled to 0.02/step (~50
    # steps of sustained neighbor exposure to fully kill a bond, instead of
    # 1 step) to test whether the previously-observed avalanche is a rate
    # problem.
    list_of_points =  9.77e9  1.35e10  22.0  2.0e8  3.5  0.99  0.85  0.20  0.02

variables
  continuous_design = 9
    descriptors  'InitialYieldStress'  'SaturatedYieldStress'  'ExponentialConstant'  'LinearConstant'  'DamageParameter1'  'DamageParameter2'  'ThresholdDamage'  'ConnectivityAsymmetryThreshold'  'SymmetricPropagationRate'

interface
  analysis_drivers = 'driver_HE0_brozzo_rigidgrip_symmetric_severance_ratelimited_forward_solve.sh'
  fork
    parameters_file = 'params.in'
    results_file    = 'results.out'

responses
  objective_functions = 1
  no_gradients
  no_hessians
