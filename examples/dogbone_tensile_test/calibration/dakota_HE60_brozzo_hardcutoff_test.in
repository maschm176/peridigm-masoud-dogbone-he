environment

method
  list_parameter_study
    # Single evaluation: Hard Cutoff at the already-correctly-timed
    # wide-ramp point (d1=3.5, d2=0.99, ThresholdDamage=0.19), HE_60's own
    # locked-in Stage 1 hardening. Not an optimization -- a one-off
    # diagnostic test of whether Hard Cutoff sharpens the pre-fracture
    # softening shape without reintroducing instability.
    list_of_points =  9.77e9  1.35e10  22.0  2.0e8  3.5  0.99  0.19

variables
  continuous_design = 7
    descriptors  'InitialYieldStress'  'SaturatedYieldStress'  'ExponentialConstant'  'LinearConstant'  'DamageParameter1'  'DamageParameter2'  'ThresholdDamage'

interface
  analysis_drivers = 'driver_HE60_brozzo_hardcutoff_test.sh'
  fork
    parameters_file = 'params.in'
    results_file    = 'results.out'

responses
  objective_functions = 1
  no_gradients
  no_hessians
