environment

method
  list_parameter_study
    # Single evaluation: HE_0's locked-in optimized Brozzo parameters
    # (d1=3.5, d2=0.99, ThresholdDamage=0.85, HE_0 Stage 1 Voce hardening),
    # rigid-grip BC, loading rate matched to Behzadinasab & Foster 2019's
    # own 1 m/s (100 cm/s per grip), Final Time scaled to 4.048e-3s. Not an
    # optimization -- a one-off diagnostic/reference run testing whether
    # matching the paper's loading rate changes the early-loading sawtooth
    # noise or the post-fracture ringing.
    list_of_points =  9.77e9  1.35e10  22.0  2.0e8  3.5  0.99  0.85

variables
  continuous_design = 7
    descriptors  'InitialYieldStress'  'SaturatedYieldStress'  'ExponentialConstant'  'LinearConstant'  'DamageParameter1'  'DamageParameter2'  'ThresholdDamage'

interface
  analysis_drivers = 'driver_HE0_brozzo_rigidgrip_slowrate_forward_solve.sh'
  fork
    parameters_file = 'params.in'
    results_file    = 'results.out'

responses
  objective_functions = 1
  no_gradients
  no_hessians
