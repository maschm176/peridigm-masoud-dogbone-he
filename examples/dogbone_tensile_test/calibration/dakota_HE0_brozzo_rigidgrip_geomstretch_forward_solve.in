environment

method
  list_parameter_study
    # Single evaluation: HE_0's locked-in Brozzo parameters, rigid-grip BC,
    # plus the new Geometric Stretch Cutoff at 0.3 (30% local relative
    # stretch) -- a first test value, chosen to sit well above the ~15-18%
    # nominal fracture strain so it shouldn't interfere with the
    # already-calibrated pre-fracture curve, while still catching bonds
    # that have severely separated post-fracture.
    list_of_points =  9.77e9  1.35e10  22.0  2.0e8  3.5  0.99  0.85  0.15

variables
  continuous_design = 8
    descriptors  'InitialYieldStress'  'SaturatedYieldStress'  'ExponentialConstant'  'LinearConstant'  'DamageParameter1'  'DamageParameter2'  'ThresholdDamage'  'GeometricCriticalStretch'

interface
  analysis_drivers = 'driver_HE0_brozzo_rigidgrip_geomstretch_forward_solve.sh'
  fork
    parameters_file = 'params.in'
    results_file    = 'results.out'

responses
  objective_functions = 1
  no_gradients
  no_hessians
